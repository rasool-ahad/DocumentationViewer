{
  "Presentation": {
    "ShowExceptionDetail": false,
    "ActiveApiLog": true,
    "CorsPolicies": [],
    "SwaggerDocs": [
      { "Name": "DocumentViewer", "Title": "DocumentViewer API", "Version": "v1" }
    ]
  },
  "SqlDatabase": {
    "ConnectionString": "Server=localhost;Database=DocumentViewer;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Identity": {
    "User": { "RequireUniqueEmail": false },
    "Password": {
      "RequiredLength": 8,
      "RequireDigit": true,
      "RequireLowercase": true,
      "RequireUppercase": true,
      "RequireNonAlphanumeric": false
    },
    "Lockout": {
      "DefaultLockoutTimeSpan": "00:05:00",
      "MaxFailedAccessAttempts": 5,
      "AllowedForNewUsers": true
    }
  },
  "Jwt": {
    "Issuer": "DocumentViewer",
    "Audience": "DocumentViewer.Api",
    "AccessTokenLifetimeMinutes": 60
  },
  "SuperAdmin": {
    "UserName": "superadmin",
    "FirstName": "Super",
    "LastName": "Admin"
  },
  "Redis": {
    "Host": "localhost",
    "Port": 6379,
    "Username": null,
    "Password": null,
    "Database": 0,
    "KeyPrefix": "DocumentViewer"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
