{
  "Presentation": {
    "ShowExceptionDetail": false,
    "ActiveApiLog": true,
    "CorsPolicies": [],
    "SwaggerDocs": [
      { "Name": "DocumentViewer.Admin", "Title": "DocumentViewer Admin API", "Version": "v1" },
      { "Name": "DocumentViewer.My", "Title": "DocumentViewer My API", "Version": "v1" }
    ]
  },
  "SqlDatabase": {
    "ConnectionString": "Server=localhost;Database=DocumentViewer;User Id=sa;Password=123456789;TrustServerCertificate=True"
  },
  "Identity": {
    "User": { "RequireUniqueEmail": false },
    "Password": {
      "RequiredLength": 8,
      "RequireDigit": true,
      "RequireLowercase": true,
      "RequireUppercase": true,
      "RequireNonAlphanumeric": false
    },
    "Lockout": {
      "DefaultLockoutTimeSpan": "00:05:00",
      "MaxFailedAccessAttempts": 5,
      "AllowedForNewUsers": true
    }
  },
  "Jwt": {
    "Issuer": "DocumentViewer",
    "Audience": "DocumentViewer.Api",
    "AccessTokenLifetimeMinutes": 60,
    "SigningKey": "replace-with-a-random-key-of-at-least-32-bytes"
  },
  "SuperAdmin": {
    "UserName": "superadmin",
    "FirstName": "Super",
    "LastName": "Admin",
    "Password":  "Aa!123456"
  },
  "Redis": {
    "Host": "127.0.0.1",
    "Port": 6379,
    "Username": null,
    "Password": null,
    "Database": 0,
    "KeyPrefix": "DocumentViewer"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
